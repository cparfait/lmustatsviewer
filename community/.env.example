# Copier en .env (jamais commité) puis remplir.

# Mot de passe Postgres : lettres et chiffres uniquement (il entre dans une URL).
# Générer par exemple avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Façade partagée avec Nginx Proxy Manager SEULEMENT (cloisonnement, cf. README).
# Vide = web-lmustatsviewer (à créer une fois : docker network create web-lmustatsviewer).
# En local : npm_local_test.
FACADE_NETWORK=

# Dossier des visuels de l'app (logos, drapeaux, données). Dans le dossier de déploiement
# du VPS (archive : compose à la racine + public/ à côté) : ./public
# Laisser vide dans le dépôt (défaut : ../public).
APP_PUBLIC_DIR=
