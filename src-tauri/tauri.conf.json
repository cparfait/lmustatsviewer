{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LMU Stats Viewer",
  "version": "1.0.0",
  "identifier": "com.cparfait.lmustatsviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LMU Stats Viewer",
        "width": 1700,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "cparfait",
    "copyright": "(c) 2026 cparfait",
    "category": "Utility",
    "shortDescription": "Statistiques et analyses pour Le Mans Ultimate",
    "longDescription": "Le Mans Ultimate Stats Viewer - visualise tes sessions, analyses tes courses, compare aux temps de la communaute ohne_speed, gere tes setups (.svm). Lit directement les fichiers du jeu, fonctionne 100% en local.",
    "resources": {
      "nsis/rFactor2SharedMemoryMapPlugin64.dll": "rFactor2SharedMemoryMapPlugin64.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/hooks.nsi",
        "displayLanguageSelector": true,
        "languages": ["French", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cparfait/lmustatsviewer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMDFBMEZDOEQ3NzNEMkEKUldRcVBYZU4vS0FCa044WGsvZnQxU1dMOGNKTDdNWnlmYzFFY1YrWGdPSkR0S2hIQlQrTDRkWEEK"
    }
  }
}
